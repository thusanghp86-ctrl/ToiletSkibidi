        expect(v3).toEqual(3)
    end)
    it("max, object", function()
        local v5 = {
            ["age"] = 25
        }
        local v8, v9 = v_u_1({
            ["alice"] = {
                ["age"] = 5
            },
            ["bertram"] = {
                ["age"] = 15
            },
            ["charlie"] = v5
        }, function(p6, p7)
            return p6.age > p7.age
        end)
        expect(v9).toEqual("charlie")
        expect(v8).toEqual(v5)
    end)
    it("max, empty", function()
        local v10, v11 = v_u_1({})
        expect(v10).toEqual(nil)
        expect(v11).toEqual(nil)
    end)
end]]></ProtectedString>
