local v_u_3 = require(v1.Packages.LightningBolt.LightningExplosion)
local v_u_4 = require(v1.Packages.LightningBolt.LightningSparks)
local v_u_5 = game.Players.LocalPlayer
v1.Remotes.LightningReplicate.OnClientEvent:Connect(function(p6, p7, p8)
    local v9 = Random.new(p8)
    local v10 = game.ReplicatedStorage.Assets.LightningModel:Clone()
    v10.Parent = game.Workspace
    v10.Part1.Position = p6
    v10.Part2.Position = p7
    local v11 = v_u_2.new(v10.Part1.Attachment1, v10.Part2.Attachment2, 20)
    v11.CurveSize0 = 15.39600717839002
    v11.CurveSize1 = 15.39600717839002
    v11.Color = Color3.fromRGB(193, 217, 255)
    v11.AnimationSpeed = 0.5
    v11.Thickness = 3
    v11.MinRadius = 0
    v11.MaxRadius = 20
    v11.MinThicknessMultiplier = 1
    v11.MaxThicknessMultiplier = 1
    v11.ColorOffsetSpeed = 4
    v11.Frequency = 6
    local v12 = v_u_4.new(v11, 5)
    v12.MinSpeed = 10
    v12.MaxSpeed = 20
    v12.MinDistance = 3
    v12.MaxDistance = 6
    v12.MinPartsPerSpark = 9
    v12.MaxPartsPerSpark = 11
    v11.Enabled = false
    v_u_3.new(v10.Part1.Attachment1.WorldPosition, 0.5, 5, ColorSequence.new(Color3.fromRGB(178, 255, 252)), Color3.fromRGB(221, 255, 202))
    local v13 = game.SoundService.Lightning:GetChildren()[v9:NextInteger(1, #game.SoundService.Lightning:GetChildren())]:Clone()
    v13.Parent = v10.Part1
    v13.PlayOnRemove = true
    v13:Destroy()
    local v14 = v_u_5.Character
    if v14 then
        local v15 = 4 * (1 - (v14.HumanoidRootPart.Position - p6).Magnitude / 300)
        local v16 = math.clamp(v15, 0, 1.5)
        game.Lighting.ExposureCompensation = v16
        task.delay(0.25, function()
            game.Lighting.ExposureCompensation = 0
        end)
    end
    for _ = 1, 6 do
        v11.Enabled = true
        task.wait(0.05)
        v11.Enabled = false
