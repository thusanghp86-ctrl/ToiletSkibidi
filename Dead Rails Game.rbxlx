						<string name="ScriptGuid">{D4D7AA37-4909-4922-AA43-F88D602C62B6}</string>
						<ProtectedString name="Source"><![CDATA[ 

local v1 = game:GetService("TweenService")
local v2 = TweenInfo.new(2, Enum.EasingStyle.Linear)
while true do
    v1:Create(script.Parent, v2, {
        ["StudsOffsetWorldSpace"] = Vector3.new(0, 5, 0)
    }):Play()
    task.wait(2)
    v1:Create(script.Parent, v2, {
        ["StudsOffsetWorldSpace"] = Vector3.new(0, 4, 0)
    }):Play()
    task.wait(2)
end]]></ProtectedString>
