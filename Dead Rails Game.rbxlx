local v_u_1 = false
script.Parent.Touched:Connect(function(p2)
    if not v_u_1 then
        if p2.Parent and (p2.Parent.Name == "Coal" and p2.Parent:FindFirstChild("TutorialBeam")) then
            p2.Parent:FindFirstChild("TutorialBeam").Enabled = false
            v_u_1 = true
            game.Workspace.StartingZone.Buildings.GeneralStore.Counter.ObjectiveMarker.BillboardGui.Enabled = true
        end
    end
end)]]></ProtectedString>
