        expect(v5).toEqual({
            "foo",
            "bar",
            "baz",
            "bar",
            "baz",
            "quz"
        })
    end)
    it("flatten, depth of 2, limit 1", function()
        local v6 = v_u_1(v_u_4, 1)
        expect(v6).toEqual({
            "foo",
