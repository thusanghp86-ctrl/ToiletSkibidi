    local v_u_2 = { "a", "b", "c" }
    it("should replace existing index", function()
        local v4 = v_u_1(v_u_2, 1, function(p3)
            assert(p3, "exists")
            return string.rep(p3, 5)
        end)
        expect(v4).toEqual({ "aaaaa", "b", "c" })
    end)
    it("should pass nil to updater for nil index", function()
        local v_u_5 = false
        local v6 = v_u_1(v_u_2, 4, function(_)
            v_u_5 = true
            return "d"
        end)
        expect(v_u_5).toEqual(true)
        expect(nil).toEqual(nil)
        expect(v6).toEqual({
            "a",
            "b",
            "c",
            "d"
        })
    end)
    it("should pass notSetValue to updater for nil index", function()
        local v8 = v_u_1(v_u_2, 4, function(p7)
            assert(p7, "exists")
            return string.rep(p7, 5)
        end, "d")
        expect(v8).toEqual({
            "a",
            "b",
            "c",
            "ddddd"
        })
    end)
end]]></ProtectedString>
