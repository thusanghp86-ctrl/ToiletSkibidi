					<string name="Name">TutorialTextChange</string>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{F74C5D60-DF0F-4A46-8A19-A4863C733C8B}</string>
					<ProtectedString name="Source"><![CDATA[ 

local v_u_1 = { "Drag gold bar to the table to sell it (0/1)", "Buy coal from the general store (0/1)", "Put the coal in your sack, and refuel the train (0/1)" }
local v_u_2 = { Vector3.new(128.527, 28.25, 29924.873), Vector3.new(128.527, 28.25, 29800), Vector3.new(56.527, 28.25, 29886.873) }
if require(game.ReplicatedStorage.Client.Controllers.ActionController.InputCategorizer).getLastInputCategory() == "KeyboardAndMouse" then
    script.Parent.MouseUnlockText.Visible = true
end
local v_u_3 = game.ReplicatedStorage.Assets.ObjectiveMarker:Clone()
v_u_3.Parent = game.Workspace
local v_u_4 = game.ReplicatedStorage.TutorialStep
if v_u_4.Value == 4 then
    script.Parent.TutorialText.Visible = false
    v_u_3:Destroy()
    script.Parent.MouseUnlockText.Visible = false
else
    v_u_3.Position = v_u_2[v_u_4.Value]
    script.Parent.TutorialText.Text = v_u_1[v_u_4.Value]
    local v_u_5 = nil
    v_u_4.Changed:Connect(function(p6)
        if p6 == 4 then
            script.Parent.TutorialText.Visible = false
            v_u_3:Destroy()
            script.Parent.MouseUnlockText.Visible = false
        else
            if v_u_4.Value == 2 then
                local v7 = game.Workspace.StartingZone.Buildings.GeneralStore.CommonLootTable.ShopItems:FindFirstChild("Coal")
                v_u_5 = game.ReplicatedStorage.Assets.TutorialBeam:Clone()
                local v8 = Instance.new("Attachment")
                v8.Parent = v7.PrimaryPart
                v_u_5.Parent = v7
                v_u_5.Attachment1 = v8
                v_u_5.Attachment0 = game.Workspace.StartingZone.Buildings.GeneralStore.Counter.ShopItemDetect.Attachment
            end
            if v_u_4.Value == 3 and v_u_5 then
                v_u_5:Destroy()
            end
            v_u_3.Position = v_u_2[p6]
            script.Parent.TutorialText.Text = v_u_1[p6]
        end
    end)
end]]></ProtectedString>
