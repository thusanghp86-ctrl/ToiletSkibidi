local v_u_1 = require(script.Parent:FindFirstChild("remove"))
return function()
    local v_u_2 = { 10, 20, 30 }
    it("remove", function()
        local v3 = v_u_1(v_u_2, 2)
        expect(v3).toEqual({ 10, 30 })
    end)
    it("remove from end", function()
        local v4 = v_u_1(v_u_2, -1)
        expect(v4).toEqual({ 10, 20 })
    end)
    it("remove from end 2", function()
        local v5 = v_u_1(v_u_2, -3)
        expect(v5).toEqual({ 20, 30 })
    end)
    it("remove out of bounds, same id", function()
        local v6 = v_u_1(v_u_2, 4)
        expect(v6).toBe(v_u_2)
    end)
    it("remove multiple indicies", function()
        local v7 = v_u_1(v_u_2, 1, 2)
        expect(v7).toEqual({ 30 })
    end)
    it("remove multiple negative indicies, preserves order", function()
        local v8 = v_u_1({
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8
        }, 8, -1)
        expect(v8).toEqual({
            1,
            2,
            3,
            4,
            5,
            6,
            7
        })
    end)
    it("remove multiple indicies, same id if no match", function()
        local v9 = {
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8
        }
        local v10 = v_u_1(v9, 100, 200, -100)
        expect(v10).toBe(v9)
    end)
end]]></ProtectedString>
