require("../../DataBanks/WeaponTypes")
return function(p1, p2, _)
    local v3 = workspace:GetServerTimeNow()
    if v3 < p1 then
        return false, "Client timestamp in the future"
    elseif p1 < v3 - 1 then
        return false, "Client timestamp too far in the past"
    else
        local v4 = p2.WeaponConfiguration.FireDelay.Value
        local v5 = p2.ServerWeaponState.CurrentAmmo.Value
        local v6 = p2.ServerWeaponState.LastFireTime.Value
        if p2.ServerWeaponState.IsReloading.Value then
            return false, "Gun is reloading"
        elseif v5 <= 0 then
            return false, "Gun has no ammo"
        elseif p1 - v6 + 0.05 < v4 then
            return false, ("Gun is on fire cooldown %*"):format(p1 - v6)
        else
            return true
        end
    end
end]]></ProtectedString>
