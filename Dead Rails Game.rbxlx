            ["b"] = 2,
            ["c"] = 3
        })
    end)
    it("should pass nil to updater for nil key", function()
        local v_u_5 = false
        local v6 = v_u_1(v_u_2, "d", function(_)
            v_u_5 = true
            return 4
        end)
        expect(v_u_5).toEqual(true)
        expect(nil).toEqual(nil)
        expect(v6).toEqual({
            ["a"] = 1,
            ["b"] = 2,
            ["c"] = 3,
            ["d"] = 4
        })
    end)
    it("should pass notSetValue to updater for nil key", function()
        local v8 = v_u_1(v_u_2, "d", function(p7)
            assert(p7, "exists")
            return p7 * 100
        end, 4)
        expect(v8).toEqual({
            ["a"] = 1,
            ["b"] = 2,
            ["c"] = 3,
            ["d"] = 400
        })
    end)
