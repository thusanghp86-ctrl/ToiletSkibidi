									<ProtectedString name="Source"><![CDATA[ 

local v1 = script.Parent:WaitForChild("Humanoid")
local v2 = script:WaitForChild("Walk")
local v3 = v1.Animator:LoadAnimation(v2)
while true do
    repeat
        wait(0.3)
    until script.Parent:FindFirstChild("HumanoidRootPart")
    if script.Parent.HumanoidRootPart.Velocity.Magnitude > 1 and script.Parent.Humanoid.PlatformStand == false then
        if not v3.IsPlaying then
            v3:Play()
        end
    elseif v3.IsPlaying then
        v3:Stop()
    end
end]]></ProtectedString>
