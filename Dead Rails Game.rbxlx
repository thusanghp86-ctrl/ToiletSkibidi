									<string name="Name">AnimateWalk</string>
									<token name="RunContext">2</token>
									<string name="ScriptGuid">{F994D7BF-B46A-4F50-9812-8C7115109D39}</string>
									<ProtectedString name="Source"><![CDATA[ 

local v1 = script.Parent.Humanoid.Animator:LoadAnimation(script.Parent.Walk)
while script.Parent.Humanoid.Health > 0 do
    if v1.IsPlaying == false and script.Parent.HumanoidRootPart.Velocity.Magnitude > 1 then
        v1:Play()
    elseif script.Parent.HumanoidRootPart.Velocity.Magnitude < 1 then
        v1:Stop()
    end
    task.wait(0.3)
end
v1:Stop()]]></ProtectedString>
