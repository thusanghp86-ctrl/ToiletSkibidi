						<ProtectedString name="Source"><![CDATA[ 

local v1 = script:FindFirstAncestor("Client")
require(v1.ReplicaClient)
local v_u_2 = {
    ["_replica"] = nil,
    ["isPlayerDataLoaded"] = function()
        return v_u_2.hasLoaded()
    end,
    ["getPlayerDataReplica"] = function()
        return v_u_2.getReplica()
    end,
    ["hasLoaded"] = function()
        return v_u_2._replica ~= nil
    end,
    ["waitForDataLoadAsync"] = function()
        while not v_u_2.isPlayerDataLoaded() do
            task.wait()
        end
    end,
    ["getReplica"] = function()
        if not v_u_2.isPlayerDataLoaded() then
            error("Cannot getPlayerDataReplica; Player data is not loaded!")
        end
        return v_u_2._replica
    end
}
return v_u_2]]></ProtectedString>
