					<ProtectedString name="Source"><![CDATA[ 

local v1 = game:GetService("ReplicatedStorage")
local v_u_2 = {
    ["Medium"] = v1.Assets.WheelBase.Medium,
    ["Large"] = v1.Assets.WheelBase.Large
}
local v_u_3 = game:GetService("RunService");
(function()
    local v4 = script.Parent.Visual
    v4.WheelBases:ClearAllChildren()
    for _, v_u_5 in v4.AxelNodes:GetChildren() do
        local v_u_6 = v_u_2[v_u_5.Name]:Clone()
        v_u_6.Parent = v4.WheelBases
        v_u_3.Heartbeat:Connect(function()
            local v7 = v_u_5.AssemblyLinearVelocity.Magnitude
            local v8 = v_u_6.Radius.Value
            local v9, _, _ = v_u_6:GetPivot():ToEulerAnglesXYZ()
            local v10 = v_u_6
            local v11 = v_u_5.CFrame
            local v12 = CFrame.Angles
            local v13 = v7 / v8
            v10:PivotTo(v11 * v12(v9 - math.rad(v13), 0, 0))
        end)
    end
end)()]]></ProtectedString>
