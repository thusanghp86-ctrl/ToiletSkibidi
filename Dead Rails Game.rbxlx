					<ProtectedString name="Source"><![CDATA[ 

local v1 = game:GetService("Players")
local v2 = game.PlaceId
local v3 = v1.LocalPlayer
local v4 = script.Parent
if game:GetService("RunService"):IsStudio() then
    v4.Enabled = false
    return
elseif v2 == 98018823628597 or v2 == 133377094302868 then
    v4.Enabled = true
    for _, v5 in v4:WaitForChild("ScreenIds"):GetChildren() do
        if v5:IsA("TextLabel") then
            local v6 = v3.UserId
            v5.Text = tostring(v6)
        end
    end
else
    v4.Enabled = false
end]]></ProtectedString>
