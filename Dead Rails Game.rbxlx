local v_u_1 = require(script.Parent.updateIn)
return function()
    local v_u_2 = {}
    local v3 = {
        ["alice"] = {
            ["age"] = 10
        }
    }
    v_u_2.persons = v3
    it("should replace existing key", function()
        local v5 = v_u_1(v_u_2, { "persons", "alice", "age" }, function(p4)
            assert(p4, "will exist")
            return p4 + 1
        end)
        local v6 = expect(v5).toEqual
        local v7 = {}
        local v8 = {
            ["alice"] = {
                ["age"] = 11
            }
        }
        v7.persons = v8
        v6(v7)
    end)
    it("should pass nil to updater for nil key", function()
        local v_u_9 = false
        local v10 = v_u_1(v_u_2, { "persons", "alice", "age" }, function(_)
            v_u_9 = true
            return 4
        end)
        expect(v_u_9).toEqual(true)
        expect(nil).toEqual(nil)
        local v11 = expect(v10).toEqual
        local v12 = {}
        local v13 = {
            ["alice"] = {
                ["age"] = 4
            }
        }
        v12.persons = v13
        v11(v12)
    end)
    it("should pass notSetValue to updater for nil key", function()
        local v15 = v_u_1(v_u_2, { "persons", "alice", "test" }, function(p14)
            assert(p14, "exists")
            return p14 + 1
        end, 4)
        local v16 = expect(v15).toEqual
        local v17 = {}
        local v18 = {
            ["alice"] = {
                ["age"] = 10,
                ["test"] = 5
            }
        }
        v17.persons = v18
        v16(v17)
    end)
end]]></ProtectedString>
