									<ProtectedString name="Source"><![CDATA[ 

local v1 = script.Parent:WaitForChild("Humanoid")
local v2 = script:WaitForChild("Walk")
local v3 = v1.Animator:LoadAnimation(v2)
while true do
    task.wait(0.1)
    if script.Parent.Humanoid.Health <= 0 then
        break
    end
    if script.Parent.HumanoidRootPart.Velocity.Magnitude > 1 then
        if not v3.IsPlaying then
            v3:Play()
        end
    elseif v3.IsPlaying then
        v3:Stop()
    end
end
if v3.IsPlaying then
    v3:Stop()
end]]></ProtectedString>
