        expect(v4).toEqual({ 10, 30 })
    end)
    it("removeValue not found, keeps identity", function()
        local v5 = v_u_1(v_u_2, 100)
        expect(v5).toBe(v_u_2)
    end)
    it("removeValue for all repeated values", function()
        local v6 = v_u_1(v_u_3, 20)
        expect(v6).toEqual({
            10,
            30,
            10,
            30
        })
    end)
    it("removeValue multiple values", function()
        local v7 = v_u_1(v_u_2, 20, 30)
        expect(v7).toEqual({ 10 })
    end)
    it("removeValue multiple values, even if some arent there", function()
        local v8 = v_u_1(v_u_2, 20, 30, 40)
        expect(v8).toEqual({ 10 })
    end)
    it("removeValue multiple values, multiple times", function()
        local v9 = v_u_1(v_u_3, 20, 30)
        expect(v9).toEqual({ 10, 10 })
    end)
end]]></ProtectedString>
