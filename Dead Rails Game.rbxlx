						<ProtectedString name="Source"><![CDATA[ 

local v_u_1 = false
local v_u_2 = game:GetService("TweenService")
local v_u_3 = game:GetService("RunService")
local v_u_4 = TweenInfo.new(3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local v_u_5 = 1
local function v_u_7()
    v_u_3.Heartbeat:Connect(function()
        local v6 = v_u_5
        script.Parent.Wheel:PivotTo(script.Parent.Wheel:GetPivot() * CFrame.Angles(math.rad(v6), 0, 0))
    end)
end
script.Parent.BasePart.PowerPrompt.Triggered:Connect(function()
    if not v_u_1 then
        v_u_1 = true
        v_u_2:Create(script.Parent.PowerSwitch.Pivot, v_u_4, {
            ["CFrame"] = script.Parent.PowerSwitch.Pivot.CFrame * CFrame.Angles(2.0943951023931953, 0, 0)
        }):Play()
        task.spawn(v_u_7)
        script.Parent.Parent.Dohiggy.Ball.Electricity.Enabled = true
        for v8 = 100, 500 do
            v_u_5 = v8 / 100
            task.wait(0.3)
            script.Parent.Parent.Dohiggy.Ball.Electricity.Size = NumberSequence.new(v8 / 100)
            script.Parent.PowerIndicator.Spedometer.SurfaceGui.ImageLabel.Gauge.Rotation = 120 + (v8 - 100) / 1.3333333333333333
        end
    end
end)]]></ProtectedString>
