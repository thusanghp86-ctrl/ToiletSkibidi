										<ProtectedString name="Source"><![CDATA[ 

local v_u_1 = nil
local _ = game.Players.LocalPlayer
local v_u_2 = game:GetService("TweenService")
local v_u_3 = TweenInfo.new(1, Enum.EasingStyle.Bounce)
local v_u_4 = TweenInfo.new(0.5, Enum.EasingStyle.Bounce)
local v_u_5 = game:GetService("UserInputService")
local v_u_6 = game.Players.LocalPlayer
v_u_6:GetMouse()
local function v_u_8()
    if v_u_1 then
        v_u_1:Destroy()
        v_u_1 = nil
    end
    script.Parent.Parent.ClickToBuy.Enabled = false
    if script.Parent.Parent.CartValue.Value ~= 0 then
        local v7 = v_u_6.leaderstats.Money.Value >= script.Parent.Parent.CartValue.Value
        v_u_1 = game.ReplicatedStorage.Assets.RegisterHighlight:Clone()
        if v7 then
            script.Parent.Parent.ClickToBuy.Title.Text = "Click to buy"
            script.Parent.Parent.ClickToBuy.Title.TextColor3 = Color3.fromRGB(12, 66, 0)
        else
            script.Parent.Parent.ClickToBuy.Title.Text = "Not enough money"
            script.Parent.Parent.ClickToBuy.Title.TextColor3 = Color3.fromRGB(66, 0, 0)
            v_u_1.FillColor = Color3.fromRGB(255, 0, 0)
            v_u_1.OutlineColor = Color3.fromRGB(255, 0, 0)
        end
        v_u_1.Parent = script.Parent.Parent
        script.Parent.Parent.ClickToBuy.Enabled = true
    end
end
script.Parent.LeverSwing.OnClientEvent:Connect(function()
    script.Parent.Purchase:Play()
    v_u_2:Create(script.Parent.Parent.TweenPart, v_u_3, {
        ["CFrame"] = script.Parent.Parent.TweenPart.CFrame * CFrame.Angles(0, 0, 90)
    }):Play()
    task.wait(1)
    v_u_2:Create(script.Parent.Parent.TweenPart, v_u_4, {
        ["CFrame"] = script.Parent.Parent.TweenPart.CFrame * CFrame.Angles(0, 0, -90)
    }):Play()
end)
script.Parent.Parent.CartValue.Changed:Connect(function()
    if v_u_5.TouchEnabled then
        v_u_8()
    end
    if v_u_1 then
        v_u_8()
    end
end)
script.Parent.ClickDetector.MouseHoverEnter:Connect(function()
    v_u_8()
end)
script.Parent.ClickDetector.MouseHoverLeave:Connect(function()
    if v_u_1 then
        v_u_1:Destroy()
        v_u_1 = nil
    end
    script.Parent.Parent.ClickToBuy.Enabled = false
end)]]></ProtectedString>
